# Seguranca: impede execucao de scripts de dependencias transitivas.
ignore-scripts=true

# Registry padrao (npm publico) para todas as dependencias.
registry=https://registry.npmjs.org/

# Registry privado GCP AR para pacotes @bhs-dev (canal dev/PR).
# Descomente para consumir artefatos dev do Artifact Registry:
